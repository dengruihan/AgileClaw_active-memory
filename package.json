{
  "name": "@agileclaw/active-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded pre-reply memory recall and per-agent Remember across conversations",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openclaw/normalization-core": "link:../AgileClaw/packages/normalization-core",
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "openclaw": "link:../AgileClaw",
    "typescript": "7.1.0-dev.20260920.1",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "packageManager": "pnpm@12.5.1",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "assetScripts": {
      "build": "node build.mjs"
    },
    "build": {
      "bundledDist": false,
      "staticAssets": [
        {
          "source": "assets",
          "output": "assets"
        }
      ]
    }
  }
}
